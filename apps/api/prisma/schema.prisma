generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Sadeed Pay Wallets (stores user_id, tier from Kamekaz, balance - no personal identity data)
model Wallet {
  id           String        @id @default(cuid())
  userId       String        @unique // GLOBAL_USER_ID from kamekaz
  tier         KycTier       @default(C1) // Tier fetched directly from Kamekaz (C0, C1, C2, C3)
  balance      Decimal       @default(0) @db.Decimal(18, 2)
  currency     String        @default("USD")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]

  @@map("wallets")
}

// Sadeed Pay Transactions Ledger (Every topup or payment/withdrawal creates a new record)
model Transaction {
  id          String    @id @default(cuid())
  walletId    String
  wallet      Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  referenceId String    @unique // Payment or Topup Reference for idempotency
  fromUserId  String    // Payer or SYSTEM for topup
  toUserId    String    // Beneficiary or SYSTEM for cashout
  amount      Decimal   @db.Decimal(18, 2)
  type        TxType
  appSource   String    @default("sadeed-pay") // "sadeed-pay" | "merchant" | "kamekaz"
  description String?
  metadata    String?   // JSON metadata for merchant callbacks / orders
  status      TxStatus  @default(DONE)
  createdAt   DateTime  @default(now())

  @@index([walletId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([appSource])
  @@index([type])
  @@index([createdAt])
  @@map("transactions")
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ACCOUNTANT)
  createdAt    DateTime  @default(now())

  @@map("admins")
}

enum KycTier {
  C0 // Unverified (cannot pay or topup)
  C1 // Basic Verified (Max $500 topup cap, cannot create payments)
  C2 // Advanced Verified (Eligible for payments, Unlimited topup)
  C3 // Corporate / VIP Verified (Unlimited)
}

enum TxType {
  TOPUP
  PAYOUT
  ORDER_PAYMENT
  REFUND
  FEE
}

enum TxStatus {
  PENDING
  DONE
  FAILED
}

enum AdminRole {
  SUPER_ADMIN
  ACCOUNTANT
}

